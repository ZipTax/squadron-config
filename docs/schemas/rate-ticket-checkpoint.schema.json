{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rate-ticket-checkpoint.schema.json",
  "title": "Rate-ticket checkpoint",
  "description": "A complete coordination envelope may describe unfinished work: null lanes/artifacts, empty results/lists, and zero counters mean not yet established. Required keys do not imply completed stages.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1,
      "description": "The checkpoint contract version. Readers must reject unknown versions instead of guessing at their meaning."
    },
    "ticket": { "type": "string", "minLength": 1 },
    "checkpoint_revision": {
      "type": "integer",
      "minimum": 1,
      "description": "The current Squadron checkpoint write. This is not a Jira issue revision or a stored history."
    },
    "updated_at": { "type": "string", "format": "date-time" },
    "stage": {
      "type": "string",
      "description": "The last stage Squadron reached. This is a task-stage name, not a Devin-selected route."
    },
    "verdict": {
      "type": "string",
      "description": "The current domain verdict in the vocabulary of the stage that established it; empty before a verdict exists."
    },
    "mechanism": {
      "type": "string",
      "description": "A concise decision record explaining where expected and actual behavior diverge; empty until established."
    },
    "lanes": {
      "type": "object",
      "properties": {
        "investigation": { "$ref": "#/$defs/lane" },
        "fix": { "$ref": "#/$defs/lane" },
        "ratevariant-cases": { "$ref": "#/$defs/lane" },
        "bruno-tests": { "$ref": "#/$defs/lane" }
      },
      "required": [
        "investigation",
        "fix",
        "ratevariant-cases",
        "bruno-tests"
      ],
      "additionalProperties": false
    },
    "production_evidence": {
      "type": "array",
      "items": { "$ref": "production-evidence.schema.json" }
    },
    "artifacts": {
      "type": "object",
      "properties": {
        "fix_pr": { "$ref": "#/$defs/pull_request" },
        "bruno_pr": { "$ref": "#/$defs/pull_request" }
      },
      "required": ["fix_pr", "bruno_pr"],
      "additionalProperties": false
    },
    "completed_stages": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Stages whose durable outputs already exist and must not be repeated on resume."
    },
    "wai_refire_count": {
      "type": "integer",
      "minimum": 0,
      "description": "How many times an independently disputed working-as-intended result has re-entered triage."
    },
    "audit": {
      "type": "object",
      "properties": {
        "iteration": { "type": "integer", "minimum": 0 },
        "last_result": { "type": "string" },
        "stall_count": { "type": "integer", "minimum": 0 }
      },
      "required": [
        "iteration",
        "last_result",
        "stall_count"
      ],
      "additionalProperties": false
    },
    "blocker": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/blocker" }
      ]
    },
    "processed_start_event_ids": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Stable bridge start IDs Squadron has already accepted. Retaining them makes a lost response safe to retry."
    },
    "next_entry": {
      "type": "object",
      "properties": {
        "mission": {
          "type": "string",
          "enum": [
            "rate-triage",
            "rate-fix",
            "rate-finalize"
          ]
        },
        "stage": { "type": "string", "minLength": 1 }
      },
      "required": [
        "mission",
        "stage"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "ticket",
    "checkpoint_revision",
    "updated_at",
    "stage",
    "verdict",
    "mechanism",
    "lanes",
    "production_evidence",
    "artifacts",
    "completed_stages",
    "wai_refire_count",
    "audit",
    "blocker",
    "processed_start_event_ids",
    "next_entry"
  ],
  "$defs": {
    "lane": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "properties": {
            "session_id": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
            "messageable": { "type": "boolean" },
            "output_revision": { "type": "integer", "minimum": 0, "description": "Zero until the first result is collected; increment for subsequent accepted results." }
          },
          "required": [
            "session_id",
            "messageable",
            "output_revision"
          ],
          "additionalProperties": false
        }
      ]
    },
    "blocker_question": {
      "type": "object",
      "properties": {
        "question": { "type": "string", "minLength": 1 },
        "context": {
          "type": "string",
          "description": "Facts established by the raising session that are needed to understand the question."
        }
      },
      "required": ["question", "context"],
      "additionalProperties": false
    },
    "pull_request": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "properties": {
            "url": { "type": "string", "minLength": 1 },
            "branch": { "type": "string", "description": "Exact branch, or empty until read." },
            "head_sha": { "type": "string", "description": "Exact head SHA, or empty until read; an empty SHA cannot establish current-head validation." }
          },
          "required": ["url", "branch", "head_sha"],
          "additionalProperties": false
        }
      ]
    },
    "blocker": {
      "type": "object",
      "properties": {
        "blocker_id": { "type": "string", "minLength": 1 },
        "generation": { "type": "integer", "minimum": 1 },
        "state": {
          "type": "string",
          "enum": [
            "waiting",
            "resume_in_flight",
            "resolved"
          ]
        },
        "raised_by": {
          "type": "object",
          "properties": {
            "lane": {
              "type": "string",
              "enum": [
                "investigation",
                "fix",
                "ratevariant-cases",
                "bruno-tests"
              ]
            },
            "session_id": { "type": "string", "pattern": "^[0-9a-f]{32}$" }
          },
          "required": [
            "lane",
            "session_id"
          ],
          "additionalProperties": false
        },
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/blocker_question" }
        },
        "root_comment_id": { "type": "string" },
        "current_question_comment_id": { "type": "string" },
        "last_processed_comment_id": { "type": "string" },
        "last_dispatched_ready_event_id": { "type": "string" },
        "question_digest": { "type": "string", "minLength": 1 },
        "resume_mission": {
          "type": "string",
          "enum": [
            "rate-triage",
            "rate-fix",
            "rate-finalize"
          ]
        },
        "resume_entry_stage": { "type": "string", "minLength": 1 }
      },
      "required": [
        "blocker_id",
        "generation",
        "state",
        "raised_by",
        "questions",
        "root_comment_id",
        "current_question_comment_id",
        "last_processed_comment_id",
        "last_dispatched_ready_event_id",
        "question_digest",
        "resume_mission",
        "resume_entry_stage"
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
